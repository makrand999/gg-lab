# One plan projection supporting two elevation levels is a real multi-level
# reconstruction; it is not the cross-product ambiguity above.
# expect: 48V 48E 2F curves=2 unresolved=0 status=inferred
/datum -30 180
/circle 20 -30 20 A plan
/point e1 0 20 elevation
/point e2 40 20 elevation
/line e1 e2 A elevation
/point e3 0 60 elevation
/point e4 40 60 elevation
/line e3 e4 A elevation
