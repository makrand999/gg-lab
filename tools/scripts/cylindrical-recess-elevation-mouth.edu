# Cylindrical recess opening through a vertical face: the full mouth circle is
# in elevation and the depth evidence is in plan. The same inference is used;
# it is not tied to a plan mouth or to a solid/feature name. The mouth normal is
# +z, the depth strokes run in -z, and the bottom cap shares the bottom loop.
# The surrounding plate is not boolean-subtracted, so the display triangle
# check reports the same expected rim overlap; the analytic certificate is ok.
# expect: 56V 84E 31F recesses=1 curves=2 surfaces=9 surfaceKinds=cylinder,plane surfaceLoops=10 surfaceShells=2 surfaceOpen=0 surfaceBoundary=0 surfaceModel=ok surfaceCertificate=ok surfaceCertificateIssues=none surfaceValidation=issues diagnostics=none unresolved=0 status=inferred
/datum -100 400
/point v0 0 0 plan
/point "v0'" 0 0 elevation
/point v1 60 0 plan
/point "v1'" 60 0 elevation
/point v2 60 -60 plan
/point "v2'" 60 0 elevation
/point v3 0 -60 plan
/point "v3'" 0 0 elevation
/point v8 0 0 plan
/point "v8'" 0 60 elevation
/point v9 60 0 plan
/point "v9'" 60 60 elevation
/point v10 60 -60 plan
/point "v10'" 60 60 elevation
/point v11 0 -60 plan
/point "v11'" 0 60 elevation
/line v0 v1 A plan
/line "v0'" "v1'" A elevation
/line v1 v2 A plan
/line v2 v3 A plan
/line "v2'" "v3'" A elevation
/line v3 v0 A plan
/line v8 v9 A plan
/line "v8'" "v9'" A elevation
/line v9 v10 A plan
/line v10 v11 A plan
/line "v10'" "v11'" A elevation
/line v11 v8 A plan
/line "v0'" "v8'" A elevation
/line "v1'" "v9'" A elevation
/line "v2'" "v10'" A elevation
/line "v3'" "v11'" A elevation
/circle 30 30 10 A elevation
/point h0 20 -60 plan
/point h1 40 -60 plan
/point h2 40 -40 plan
/point h3 20 -40 plan
/line h0 h1 A plan
/line h1 h2 A plan
/line h2 h3 A plan
/line h3 h0 A plan

# The mouth is z=60 and the shared bottom loop is z=40.
# expect: surfaceChecks=2 surfaceQueries=ok
# surface-query: {"operation":"section","surface":0,"plane":{"origin":{"x":30,"y":30,"z":50},"normal":{"x":0,"y":0,"z":1}},"expect":{"kind":"circle","radius":10,"center":{"x":30,"y":30,"z":50}}}
# surface-query: {"operation":"intersect","surfaces":[0,1],"expect":{"kind":"circle","radius":10,"relation":"transverse","center":{"x":30,"y":30,"z":40}}}
