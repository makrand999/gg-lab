# Cylindrical recess (blind hole) in a plate. The full mouth circle is in
# plan; the elevation supplies the face edge, the two edge-on depth strokes at
# the mouth diameter, and the bottom edge. The cylinder axis is the mouth
# normal, the strokes fix the depth, and the bottom circle is the mouth circle
# translated by that depth. The bottom cap and the exact mouth stroke share
# their boundary curves with the cylinder. No solid or feature name is read.
# The recess mouth is subtracted from the host plate face as an inner loop, so
# the cavity closes analytically. The display triangle check still reports the
# rim overlap because display faces are not cut; the analytic certificate is
# the authority here.
# expect: 56V 84E 31F recesses=1 curves=2 surfaces=8 surfaceKinds=cylinder,plane surfaceLoops=10 surfaceShells=1 surfaceOpen=0 surfaceBoundary=0 surfaceModel=ok surfaceCertificate=ok surfaceCertificateIssues=none surfaceValidation=issues diagnostics=none unresolved=0 status=inferred
/datum -100 400
/point v0 0 0 plan
/point "v0'" 0 20 elevation
/point v1 60 0 plan
/point "v1'" 60 20 elevation
/point v2 60 -60 plan
/point "v2'" 60 20 elevation
/point v3 0 -60 plan
/point "v3'" 0 20 elevation
/point v8 0 0 plan
/point "v8'" 0 60 elevation
/point v9 60 0 plan
/point "v9'" 60 60 elevation
/point v10 60 -60 plan
/point "v10'" 60 60 elevation
/point v11 0 -60 plan
/point "v11'" 0 60 elevation
/line v0 v1 A plan
/line "v0'" "v1'" A elevation
/line v1 v2 A plan
/line v2 v3 A plan
/line "v2'" "v3'" A elevation
/line v3 v0 A plan
/line v8 v9 A plan
/line "v8'" "v9'" A elevation
/line v9 v10 A plan
/line v10 v11 A plan
/line "v10'" "v11'" A elevation
/line v11 v8 A plan
/line "v0'" "v8'" A elevation
/line "v1'" "v9'" A elevation
/line "v2'" "v10'" A elevation
/line "v3'" "v11'" A elevation
/circle 30 -30 10 A plan
/point h0 20 60 elevation
/point h1 40 60 elevation
/point h2 40 40 elevation
/point h3 20 40 elevation
/line h0 h1 A elevation
/line h1 h2 A elevation
/line h2 h3 A elevation
/line h3 h0 A elevation

# The cylinder radius is 10 at mid-depth and at the shared bottom loop.
# expect: surfaceChecks=6 surfaceQueries=ok
# surface-query: {"operation":"section","surface":0,"plane":{"origin":{"x":30,"y":50,"z":30},"normal":{"x":0,"y":1,"z":0}},"expect":{"kind":"circle","radius":10,"center":{"x":30,"y":50,"z":30}}}
# surface-query: {"operation":"intersect","surfaces":[0,1],"expect":{"kind":"circle","radius":10,"relation":"transverse","center":{"x":30,"y":40,"z":30}}}
# surface-query: {"operation":"intersect","surfaces":[0,4],"expect":{"kind":"circle","radius":10,"relation":"transverse","center":{"x":30,"y":60,"z":30}}}
# surface-query: {"operation":"classify","surface":4,"point":{"x":30,"y":60,"z":30},"expect":{"status":"outside","method":"plane-loops"}}
# surface-query: {"operation":"topology","expect":{"contract":"analytic-topology-v1","summary":{"faces":8,"edges":14,"vertices":10,"loops":10,"openEdges":0,"sharedEdges":14,"nonmanifoldEdges":0,"status":"closed"},"edges":[{"id":"c:0","kind":"curve","useCount":2,"status":"shared"},{"id":"c:1","kind":"curve","useCount":2,"status":"shared"}]}}
# surface-query: {"operation":"feature-graph","expect":{"contract":"feature-graph-v1","summary":{"faces":8,"edges":14,"convex":12,"concave":2,"smooth":0,"open":0,"unknown":0,"recesses":1,"fillets":0},"features":[{"type":"recess","family":"cylindrical","closure":"host","faces":["surface:0"]}]}}
