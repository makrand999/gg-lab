# Cylindrical fillet between two planar faces, bounded by straight tangent
# boundaries. The elevation supplies a quarter arc tangent to a vertical wall
# edge and a horizontal floor edge. The plan supplies the two tangent generator
# lines and the two end strokes. The two coaxial end arcs are lifted from the
# elevation arc; the fillet cylinder shares its two straight generator
# boundaries with the wall and floor plane strips. The ends and the outer face
# edges remain open: this is a bounded feature patch, not a Boolean-subtracted
# plate. The display mesh is a consistent open cylinder-plus-strips complex.
# expect: 18V 27E 11F fillets=1 curves=2 surfaces=6 surfaceKinds=cylinder,plane surfaceLoops=6 surfaceShells=1 surfaceOpen=0 surfaceBoundary=0 surfaceModel=ok surfaceCertificate=ok surfaceCertificateIssues=none surfaceCertificateChecks=72 surfaceLineBoundaries=10 surfaceSharedLineBoundaries=10 surfaceCurveBoundaries=2 surfaceValidation=partial diagnostics=none unresolved=0 status=inferred
/datum -100 400
# Elevation: true-shape quarter fillet arc r=10, centre (10,10), from the wall
# tangent (0,10) to the floor tangent (10,0). The two face edges are tangent
# at those endpoints and extend away from the fillet.
/point w0 0 10 elevation
/point w1 0 40 elevation
/line w0 w1 A elevation
/point f0 10 0 elevation
/point f1 40 0 elevation
/line f0 f1 A elevation
/arc 10 10 10 180 270 A elevation
# Plan: the tangent generator lines are at x=0 and x=10; the two end strokes
# span the fillet length from z=0 to z=40 (plan y = -z).
/point a 0 0 plan
/point b 0 -40 plan
/point c 10 0 plan
/point d 10 -40 plan
/line a b A plan
/line c d A plan
/line a c A plan
/line b d A plan

# The fillet cylinder section at mid-length is a circle r=10 centred on its
# axis. Both tangent planes meet the cylinder in one generator line.
# expect: surfaceChecks=5 surfaceQueries=ok
# surface-query: {"operation":"section","surface":0,"plane":{"origin":{"x":10,"y":10,"z":20},"normal":{"x":0,"y":0,"z":1}},"expect":{"kind":"circle","radius":10,"center":{"x":10,"y":10,"z":20}}}
# surface-query: {"operation":"intersect","surfaces":[0,1],"expect":{"kind":"line","relation":"tangent"}}
# surface-query: {"operation":"attach","surfaces":[0,1],"line":{"kind":"line","start":{"x":0,"y":10,"z":10},"end":{"x":0,"y":10,"z":30}},"expect":{"boundary":{"useCount":2},"validation":{"status":"partial"},"certificate":{"status":"partial"}}}
# A one-loop fillet has no second end loop to bound a crossing cut.
# surface-query: {"operation":"split","surface":0,"plane":{"origin":{"x":10,"y":10,"z":20},"normal":{"x":0,"y":0,"z":1}},"expect":{"refused":true,"diagnostic":{"code":"split-patch-topology-unsupported"}}}
# surface-query: {"operation":"feature-graph","expect":{"contract":"feature-graph-v1","summary":{"faces":6,"edges":12,"convex":2,"concave":8,"smooth":2,"open":0,"unknown":0,"fillets":1},"features":[{"type":"fillet","family":"cylindrical","closure":"closed","faces":["surface:0","surface:1","surface:2","surface:3","surface:4","surface:5"]}]}}
