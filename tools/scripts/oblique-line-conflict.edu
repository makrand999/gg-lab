# A horizontal line cannot be the edge-on projection of either mirror plane.
# expect: curves=0 diagnostics=oblique-curve-projection-missing,oblique-line-conflict unresolved=2 status=oblique-line-conflict
/datum -100 400
/ellipse 20 -30 14.1421356237 20 A plan
/point a 0 30 elevation
/point b 40 30 elevation
/line a b A elevation
