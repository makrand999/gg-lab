# A side-view station is checked through the profile frame; unmatched ink stays reported.
# expect: 7V 6E 0F curves=1 unresolved=1 status=partial
/datum -30 180
/profile 100 0 -1
/arc 70 40 20 0 90 A profile
/point a 10 40 elevation
/point b 10 60 elevation
/line a b A elevation
/point c 90 40 profile
/point d 130 40 profile
