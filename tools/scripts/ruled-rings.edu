# Unequal circular boundaries joined by straight generators.
# expect: 48V 72E 26F curves=2 unresolved=0 status=inferred
/datum -30 70
/circle 20 -30 20 A plan
/circle 20 -30 10 A plan
/point a' 0 0 elevation
/point b' 40 0 elevation
/point c' 30 50 elevation
/point d' 10 50 elevation
/line a' b' A elevation
/line b' c' A elevation
/line c' d' A elevation
/line d' a' A elevation
