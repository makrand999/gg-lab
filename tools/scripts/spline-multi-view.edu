# One spatial curve appears in all three views; a second stays in plan and
# elevation only. Both must be accepted, and the first keeps three-view evidence.
# expect: curves=2 parametricCurves=2 curveFit=ok curveReprojection=ok curvePreview=ok throughEdit=ok diagnostics=curve-surface-unresolved unresolved=2 status=partial
/datum -60 180
/profile 100 0 1
/point a 0 -10 plan
/point b 20 -30 plan
/point c 40 -20 plan
/point d 100 -50 plan
/point e 120 -70 plan
/point f 140 -60 plan
/curve-through a b c plan
/curve-through d e f plan
/point a' 0 10 elevation
/point b' 20 40 elevation
/point c' 40 20 elevation
/point d' 100 60 elevation
/point e' 120 90 elevation
/point f' 140 70 elevation
/curve-through a' b' c' elevation
/curve-through d' e' f' elevation
/point a'' 110 10 profile
/point b'' 130 40 profile
/point c'' 120 20 profile
/curve-through a'' b'' c'' profile
