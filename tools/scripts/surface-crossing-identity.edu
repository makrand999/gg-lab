# A crossing split writes ordered `elements` loops with analytic sub-arcs.
# Both split pieces share the same section sub-arc; serialization must keep
# that seam, and Surfaces.build must accept the elements-only loops back.
# expect: 48V 72E 26F curves=2 surfaces=3 surfaceKinds=cylinder,plane surfaceLoops=4 surfaceShells=1 surfaceOpen=0 surfaceBoundary=0 surfaceModel=ok surfaceCertificate=ok unresolved=0 status=inferred
/datum -30 80
/point o 20 -30 plan
/circle o 20 A plan
/point a 0 0 elevation
/point b 40 0 elevation
/point c 40 50 elevation
/point d 0 10 elevation
/line a b A elevation
/line b c A elevation
/line c d A elevation
/line d a A elevation

# expect: surfaceChecks=2 surfaceQueries=ok
# surface-query: {"operation":"split","surface":0,"plane":{"origin":{"x":20,"y":25,"z":30},"normal":{"x":0,"y":1,"z":0}},"save":{"positive":"pos","negative":"neg"},"expect":{"refused":false,"sectionArcCount":1,"identity":{"before":{"boundaries":4,"shared":1,"open":3,"nonmanifold":0},"after":{"boundaries":4,"shared":1,"open":3,"nonmanifold":0}},"positive":{"loops":[{"kind":"outer","elements":[{"kind":"curve"}]}]},"negative":{"loops":[{"kind":"outer","elements":[{"kind":"curve"}]},{"kind":"outer","curves":[0]}]}}}
