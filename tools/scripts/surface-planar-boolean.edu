# Planar-region Boolean on two coplanar faces with straight loops. The
# arrangement splits shared edges, classifies cells, and merges the selected
# boundary. Curved boundaries are refused elsewhere; this sheet tests the
# straight polygon path.
# expect: surfaceChecks=5 surfaceQueries=ok
/datum -100 100
/point a 0 0 plan
/point "a'" 0 20 elevation

