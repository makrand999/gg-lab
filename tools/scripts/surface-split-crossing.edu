# The cutting plane y=25 crosses the inclined top loop of the truncated
# cylinder. split() cuts that ellipse into two parameterized sub-arcs and cuts
# the circular section at the same stations. The positive sliver keeps one
# top sub-arc plus the section arc; the negative band keeps the other top
# sub-arc, the same section arc, and the untouched bottom loop.
# expect: 48V 72E 26F curves=2 surfaces=3 surfaceKinds=cylinder,plane surfaceLoops=4 surfaceShells=1 surfaceOpen=0 surfaceBoundary=0 surfaceModel=ok surfaceCertificate=ok surfaceCertificateIssues=none surfaceValidation=ok unresolved=0 status=inferred
/datum -30 80
/point o 20 -30 plan
/circle o 20 A plan
/point a 0 0 elevation
/point b 40 0 elevation
/point c 40 50 elevation
/point d 0 10 elevation
/line a b A elevation
/line b c A elevation
/line c d A elevation
/line d a A elevation

# expect: surfaceChecks=4 surfaceQueries=ok
# surface-query: {"operation":"split","surface":0,"plane":{"origin":{"x":20,"y":25,"z":30},"normal":{"x":0,"y":1,"z":0}},"expect":{"refused":false,"section":{"kind":"circle","radius":20,"center":{"x":20,"y":25,"z":30}},"sectionArcCount":1,"surfaces":[{"kind":"cylinder","closed":false},{"kind":"cylinder","closed":false}],"positive":{"loops":[{"kind":"outer"}]},"negative":{"loops":[{"kind":"outer"},{"kind":"outer"}]},"validation":{"status":"partial","openBoundaries":3,"closedShells":0},"certificate":{"status":"partial","counts":{"sharedBoundaries":1,"openBoundaries":3,"boundaryLoops":3,"closedShells":0}}}}
