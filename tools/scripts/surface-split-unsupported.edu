# A complete sphere can be split. Trimming it first leaves a single boundary
# loop but no recess cap metadata, so the material side (which spherical cap
# is the patch) is not recorded. A later crossing cut is refused with a
# specific diagnostic instead of guessing that side.
# expect: 86V 252E 168F spheres=1 surfaces=1 surfaceKinds=sphere surfaceLoops=0 surfaceShells=1 surfaceOpen=0 surfaceBoundary=0 surfaceModel=ok surfaceCertificate=ok surfaceCertificateIssues=none surfaceValidation=ok unresolved=0 status=inferred
/datum -100 400
/circle 20 -30 20 A plan
/circle 20 30 20 A elevation

# expect: surfaceChecks=3 surfaceQueries=ok
# surface-query: {"operation":"trim","surface":0,"plane":{"origin":{"x":20,"y":30,"z":30},"normal":{"x":0,"y":1,"z":0}},"keepPositive":true,"save":"trimmed","expect":{"surface":{"kind":"sphere","closed":false},"validation":{"status":"partial","openBoundaries":1}}}
# The trimmed patch's loop is the y=30 circle. The x=20 plane crosses that
# loop at two points, so this is a crossing-loop case, not a plane-on-loop one.
# surface-query: {"operation":"split","from":"trimmed","plane":{"origin":{"x":20,"y":30,"z":30},"normal":{"x":1,"y":0,"z":0}},"expect":{"refused":true,"diagnostic":{"code":"split-sphere-cap-unknown","surfaceId":"surface:0/trim"}}}
# surface-query: {"operation":"split","surface":0,"plane":{"origin":{"x":20,"y":30,"z":30},"normal":{"x":0,"y":1,"z":0}},"expect":{"refused":false,"section":{"kind":"circle","radius":20},"sectionArcCount":0,"surfaces":[{"kind":"sphere"},{"kind":"sphere"}],"validation":{"status":"ok","closedShells":1}}}
